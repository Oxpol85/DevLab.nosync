# --- ENTORNOS VIRTUALES Y BINARIOS ---
# No queremos guardar las librerías instaladas, solo el código
**/venv/
**/bin/
**/lib/
**/include/
pyvenv.cfg

# --- PYTHON ---
# Archivos temporales que genera Python al ejecutarse
**/__pycache__/
*.pyc
*.pyo
*.pyd

# --- SISTEMA OPERATIVO (MAC) ---
# Archivos ocultos de macOS que no sirven para el código
.DS_Store
.AppleDouble
.LSOverride

# --- AZURE & LOGS ---
# Evita subir registros de errores locales o archivos de cuotas
*.log
.azure/
# Evita subir archivos de configuración local de Azure
*.azureconfig   
# Evitar Subir de contraseñas o claves de acceso
*.env
*.secret    
# --- OTROS ---
# Archivos de configuración de editores de código
.vscode/
.idea/
# Archivos de configuración de sistemas de control de versiones
.git/
.gitignore
# Archivos de configuración de herramientas de desarrollo
*.sln
*.suo
*.xcodeproj
*.xcworkspace       
